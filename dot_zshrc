#
# Bindkeys
#

bindkey "^P" history-beginning-search-backward
bindkey "^N" history-beginning-search-forward

# Ctrl+W を / で止まるように
backward-kill-to-slash() {
  local WORDCHARS="${WORDCHARS:s/\//}"
  local last="${LBUFFER[-1]}"

  if [[ "$last" == [[:alnum:]] ]] || [[ "${WORDCHARS}" == *"$last"* ]]; then
    zle backward-kill-word
  else
    local i=${#LBUFFER}
    while (( i > 0 )); do
      local c="${LBUFFER[i]}"
      [[ "$c" == [[:alnum:]] ]] || [[ "${WORDCHARS}" == *"$c"* ]] && break
      (( i-- ))
    done
    LBUFFER="${LBUFFER[1,i]}"
  fi
}
zle -N backward-kill-to-slash
bindkey '^W' backward-kill-to-slash

#
# Autoloads
#

autoload -Uz bracketed-paste-url-magic
zle -N bracketed-paste bracketed-paste-url-magic
autoload -Uz zmv

#
# Completions
#

_python_m_complete() {
    local cur="${words[CURRENT]}"
    if [[ "${words[CURRENT-1]}" == "-m" ]]; then
        local path_prefix="${cur//.//}"
        local matches=($(find . -path "./${path_prefix}*" \( -name "*.py" -o -type d \) 2>/dev/null \
            | sed 's|^\./||; s|\.py$||; s|/|.|g' \
            | grep -v '__'))
        compadd -a matches
    else
        _default
    fi
}

#
# Aliases
#

alias l='eza --time-style=iso --icons=auto --classify=auto --group-directories-first'
alias la='l -a'
alias ll='l -l --git'
alias lla='ll -a'
alias lt='ll -T -L=2'      # in tree view.
alias lta='lt -a'
alias lm='ll -humU -s=mod'  # sorted by modified date, most recent last with headers

alias rm='trash'

alias c='claude'

#
# Zstyles
#
zstyle ':completion::complete:*' use-cache on
zstyle ':completion::complete:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
unsetopt CASE_GLOB

zstyle ':completion:*:*:*:*:*' menu select=2
zstyle ':completion:*:matches' group 'yes'
zstyle ':completion:*:options' description 'yes'
zstyle ':completion:*:options' auto-description '%d'
zstyle ':completion:*:corrections' format ' %F{green}-- %d (errors: %e) --%f'
zstyle ':completion:*:descriptions' format ' %F{yellow}-- %d --%f'
zstyle ':completion:*:messages' format ' %F{purple} -- %d --%f'
zstyle ':completion:*:warnings' format ' %F{red}-- no matches found --%f'
zstyle ':completion:*:default' list-prompt '%S%M matches%s'
zstyle ':completion:*' format ' %F{yellow}-- %d --%f'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose yes

