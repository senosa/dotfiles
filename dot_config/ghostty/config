#
# Appearance
#

# font-size = 14
font-family = UDEV Gothic 35NFLG

theme = Catppuccin Mocha
# palette = 8=#7f849c

# default palette
# palette = 0=#45475a
# palette = 1=#f38ba8
# palette = 2=#a6e3a1
# palette = 3=#f9e2af
# palette = 4=#89b4fa
# palette = 5=#f5c2e7
# palette = 6=#94e2d5
# palette = 7=#a6adc8
# palette = 8=#585b70
# palette = 9=#f37799
# palette = 10=#89d88b
# palette = 11=#ebd391
# palette = 12=#74a8fc
# palette = 13=#f2aede
# palette = 14=#6bd7ca
# palette = 15=#bac2de

# background-opacity = 0.8
# background-blur = 20
# background-blur = macos-glass-regular
background-blur = macos-glass-clear
split-divider-color = #babbf1

#
# Window
#

window-padding-x = 8
# window-padding-y = 8
window-padding-balance = true

#
# Keybinds
#
# https://ghostty.org/docs/config/reference#keybind
# `ghostty +list-keybinds --default` to see all default keybinds.
keybind = ctrl+m=text:\n
keybind = ctrl+i=text:\t

#
# Clipboard
#
# https://ghostty.org/docs/config/reference#copy-on-select
# Sets the behavior of text selection.
# When set to "clipboard", selected text is automatically copied to the system clipboard.
copy-on-select = clipboard

#
# OS Specific
#

macos-window-buttons = hidden
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
