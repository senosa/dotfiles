[user]
	name = senosa
	email = senosa@gmail.com
[color]
	ui = auto
[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  dark = true
[merge]
  conflictStyle = zdiff3
[push]
	default = simple
[pull]
	rebase = false
[ghq]
	root = ~/src
[init]
	defaultBranch = main
[include]
	path = ~/.config/git/catppuccin.gitconfig
[delta]
	features = catppuccin-mocha
