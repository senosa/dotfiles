// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // General
  "tab_size": 2,
  "cli_default_open_behavior": "existing_window",

  // Appearance
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "icon_theme": "Catppuccin Mocha",
  "buffer_font_family": "UDEV Gothic 35NFLG",

  // Keymap
  "base_keymap": "VSCode",
  "vim_mode": true,

  // Editor
  "autosave": "on_focus_change",
  "soft_wrap": "editor_width",
  "show_whitespaces": "all",

  // Languages & Tools
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          // Ruff server settings go here
          "lineLength": 160,
          "lint": {
            "extendSelect": [
              "I", // isort: importの並び順
              "E", // pycodestyle Error: PEP 8の基本エラー
              "W", // pycodestyle Warning: PEP 8の警告
              "F", // pyflakes: 未使用変数・未定義名など (デフォルトで入ってるが明示)
              "B", // flake8-bugbear: よくあるバグパターン
              "UP", // pyupgrade: 古い書き方を新しい構文に
              "PT", // flake8-pytest-style: pytestの書き方を統一
              "SIM", // flake8-simplify: もっとシンプルに書けるコードを指摘
              "RUF" // Ruff固有ルール: 雑多な改善
            ],
            "ignore": [
              "E501" // 行長はformatterに任せるので除外
            ]
          }
        }
      }
    }
  },
  "file_types": {
    "JSONC": ["**/zed/**/*.json"],
    "Shell Script": [".env.*", "dot_zshrc"],
    "TOML": ["config", "conf"]
  },
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true
      },
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    }
  },

  // Panels
  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false
  },
  "collaboration_panel": {
    "button": false
  },

  // Terminal
  "terminal": {
    "blinking": "on",
    "copy_on_select": true,
    "font_family": "UDEV Gothic NFLG",
    "font_size": 13,
    // "line_height": "comfortable",
    "cursor_shape": "bar",
    "option_as_meta": true
  },

  // AI
  "edit_predictions": {
    "provider": "zed"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  }
}
